{
  "name": "voice-hotkey-electron",
  "version": "0.1.0",
  "description": "Minimal Electron-based voice-to-text tray app (rewrite)",
  "main": "src/main.js",
  "scripts": {
  "start": "electron .",
  "test": "node --test",
  "build": "electron-builder --mac",
  "dist": "electron-builder --mac --x64",
  "dist:arm64": "electron-builder --mac --arm64",
  "dist:universal": "electron-builder --mac --universal"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "^25.0.0",
    "electron-builder": "^24.0.0"
  },
  "dependencies": {
    "electron-store": "^8.0.0",
    "node-fetch": "^3.3.1"
  },
  "build": {
    "appId": "com.example.voicehotkey",
    "mac": {
      "category": "public.app-category.productivity",
      "target": ["dmg"],
      "extendInfo": {
        "NSMicrophoneUsageDescription": "The app requires microphone access to record voice for local transcription.",
        "NSAppleEventsUsageDescription": "Needed to paste transcriptions into the frontmost app via AppleScript when auto-paste is enabled."
      }
    },
    "extraResources": [
      {
        "from": "build/ffmpeg",
        "to": "ffmpeg",
        "filter": ["**/*"]
      }
    ]
  }
}

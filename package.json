{
  "name": "voice-hotkey-electron",
  "version": "1.0.5",
  "description": "Minimal Electron-based voice-to-text tray app (rewrite)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amateur-dev/local-hotkey-voice-mac-app.git"
  },
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "doctor": "electron scripts/doctor.js",
    "test": "node --test test/**/*.test.js",
    "build": "electron-builder --mac",
    "dist": "electron-builder --mac --x64",
    "dist:arm64": "electron-builder --mac --arm64",
    "dist:universal": "electron-builder --mac --universal"
  },
  "author": {
    "name": "Dipesh Sukhani",
    "email": "me@dipeshsukhani.dev",
    "url": "https://dipeshsukhani.dev"
  },
  "license": "MIT",
  "devDependencies": {
    "electron": "^25.9.8",
    "electron-builder": "^24.0.0"
  },
  "dependencies": {
    "better-sqlite3": "^12.9.0",
    "electron-store": "^8.0.0",
    "node-fetch": "^3.3.1"
  },
  "build": {
    "appId": "com.example.voicehotkey",
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "extendInfo": {
        "NSMicrophoneUsageDescription": "The app requires microphone access to record voice for local transcription.",
        "NSAppleEventsUsageDescription": "Needed to paste transcriptions into the frontmost app via AppleScript when auto-paste is enabled."
      }
    },
    "extraResources": [
      {
        "from": "build/ffmpeg",
        "to": "ffmpeg",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "build/whisper",
        "to": "whisper",
        "filter": [
          "**/*"
        ]
      }
    ]
  }
}

{
  "name": "astra",
  "version": "2.0.1",
  "description": "ASTRA voice-to-text for macOS",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amateur-dev/local-hotkey-voice-mac-app.git"
  },
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "doctor": "electron scripts/doctor.js",
    "test": "npm rebuild better-sqlite3 && node --test test/**/*.test.js && npx electron-rebuild -f -w better-sqlite3",
    "build": "electron-builder --mac",
    "dist": "electron-builder --mac --x64",
    "dist:arm64": "electron-builder --mac --arm64",
    "dist:universal": "electron-builder --mac --universal"
  },
  "author": {
    "name": "Dipesh Sukhani",
    "email": "me@dipeshsukhani.dev",
    "url": "https://dipeshsukhani.dev"
  },
  "license": "MIT",
  "devDependencies": {
    "electron": "^40.9.3",
    "electron-builder": "^26.8.1"
  },
  "dependencies": {
    "better-sqlite3": "^12.9.0",
    "electron-store": "^8.0.0",
    "node-fetch": "^3.3.1"
  },
  "build": {
    "appId": "dev.dipeshsukhani.astra",
    "productName": "ASTRA",
    "afterSign": "scripts/afterSign.js",
    "files": [
      "src/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "identity": null,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.inherit.plist",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "extendInfo": {
        "NSMicrophoneUsageDescription": "ASTRA needs microphone access to record your voice and transcribe it locally on your Mac.",
        "NSAppleEventsUsageDescription": "ASTRA needs this to automatically paste transcribed text into the app you are using.",
        "NSScreenCaptureUsageDescription": "ASTRA can optionally read your screen to provide context-aware AI responses."
      }
    },
    "extraResources": [
      {
        "from": "build/ffmpeg",
        "to": "ffmpeg",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "build/whisper",
        "to": "whisper",
        "filter": [
          "**/*"
        ]
      }
    ]
  }
}
